{
  "name": "ejs-smart-colorizer",
  "displayName": "EJS Smart Colorizer",
  "description": "Coloreador avanzado de etiquetas EJS para VS Code: salida (<%=) en Verde Lima + Cian, estructuras de control (<%) en Amarillo, detector completo de errores de uso en Rojo Subrayado, comentarios unificados con HTML/JS y snippets.",
  "version": "1.3.0",
  "publisher": "fsolaje-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ejs",
        "extensions": [
          ".ejs"
        ],
        "aliases": [
          "EJS",
          "ejs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ejs",
        "scopeName": "text.html.ejs",
        "path": "./syntaxes/ejs.tmLanguage.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic"
        ]
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/ejs.json"
      },
      {
        "language": "ejs",
        "path": "./snippets/ejs.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "ejs": "html"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "name": "EJS: Apertura <% y cierre %> de etiquetas de SALIDA (<%= y <%-) en Verde Lima",
            "scope": [
              "punctuation.section.embedded.begin.output.ejs",
              "punctuation.section.embedded.end.output.escaped.ejs",
              "punctuation.section.embedded.end.output.unescaped.ejs"
            ],
            "settings": {
              "foreground": "#a3e635",
              "fontStyle": "bold"
            }
          },
          {
            "name": "EJS: Apertura <% y cierre %> de ESTRUCTURAS DE CONTROL (<% ... %>) en Amarillo",
            "scope": [
              "punctuation.section.embedded.begin.scriptlet.ejs",
              "punctuation.section.embedded.end.scriptlet.ejs"
            ],
            "settings": {
              "foreground": "#ffea00",
              "fontStyle": "bold"
            }
          },
          {
            "name": "EJS: Símbolo complementario '=' en Salida Escapada (<%=) en Cian Brillante",
            "scope": [
              "keyword.operator.output.escaped.ejs"
            ],
            "settings": {
              "foreground": "#00f5d4",
              "fontStyle": "bold"
            }
          },
          {
            "name": "EJS: Símbolo complementario '-' en Salida Sin Escapar (<%-) en Naranja Ámbar",
            "scope": [
              "keyword.operator.output.unescaped.ejs"
            ],
            "settings": {
              "foreground": "#fb923c",
              "fontStyle": "bold"
            }
          },
          {
            "name": "EJS: Símbolos complementarios '_' y '-' de Recorte de Espacio (<%_, _%>, -%>) en Cian Brillante",
            "scope": [
              "keyword.operator.whitespace.slurp.ejs",
              "keyword.operator.whitespace.trim.ejs"
            ],
            "settings": {
              "foreground": "#00f5d4",
              "fontStyle": "bold"
            }
          },
          {
            "name": "EJS: ALERTA de uso incorrecto o error sintáctico en cualquier etiqueta EJS",
            "scope": [
              "invalid.illegal.double-open.ejs",
              "invalid.illegal.invalid-modifier.ejs",
              "invalid.illegal.empty-tag.ejs",
              "invalid.illegal.nested-comment.ejs",
              "invalid.illegal.control-in-output.ejs",
              "invalid.illegal.wrong-include.ejs",
              "invalid.illegal.missing-equals.ejs",
              "invalid.illegal.missing-equals.begin.ejs",
              "invalid.illegal.missing-equals.end.ejs",
              "variable.other.missing-equals.ejs",
              "invalid.illegal.orphan-close.ejs"
            ],
            "settings": {
              "foreground": "#ff4757",
              "fontStyle": "bold underline"
            }
          },
          {
            "name": "EJS: Delimitadores literales escapados (<%% y %%>)",
            "scope": [
              "constant.character.escape.ejs"
            ],
            "settings": {
              "foreground": "#c084fc",
              "fontStyle": "bold"
            }
          }
        ]
      }
    }
  }
}
