{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EJS Smart Colorizer Injection",
  "scopeName": "text.html.ejs.smart",
  "injectionSelector": "L:text.html.basic -comment.block.html, L:string.quoted.double.html, L:string.quoted.single.html, L:meta.tag, L:text.html.ejs",
  "patterns": [
    {
      "include": "#ejs-comment"
    },
    {
      "include": "#ejs-escaped-delimiter"
    },
    {
      "include": "#ejs-missing-equals-warning"
    },
    {
      "include": "#ejs-output-escaped"
    },
    {
      "include": "#ejs-output-unescaped"
    },
    {
      "include": "#ejs-scriptlet-slurp"
    },
    {
      "include": "#ejs-scriptlet-control"
    }
  ],
  "repository": {
    "ejs-comment": {
      "name": "comment.block.ejs",
      "begin": "<%#",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.ejs"
        }
      },
      "end": "[-_]?%>",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.ejs"
        }
      }
    },
    "ejs-escaped-delimiter": {
      "name": "constant.character.escape.ejs",
      "match": "<%%|%%>"
    },
    "ejs-missing-equals-warning": {
      "comment": "Detecta cuando se olvida el signo = al imprimir una propiedad/variable, ej: <% pelicula.Genre %>",
      "name": "meta.embedded.missing-equals.ejs",
      "match": "(<%)(\\s+(?!if\\b|else\\b|for\\b|while\\b|do\\b|switch\\b|case\\b|default\\b|break\\b|continue\\b|return\\b|const\\b|let\\b|var\\b|function\\b|try\\b|catch\\b|finally\\b|throw\\b|delete\\b|typeof\\b|void\\b|yield\\b|await\\b|import\\b|export\\b|class\\b|debugger\\b)[a-zA-Z_$][a-zA-Z0-9_$]*(?:\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*(?:\\[[a-zA-Z0-9_$'\"\\s]+\\])*\\s*)(%>)",
      "captures": {
        "1": {
          "name": "invalid.illegal.missing-equals.begin.ejs"
        },
        "2": {
          "name": "variable.other.missing-equals.ejs"
        },
        "3": {
          "name": "invalid.illegal.missing-equals.end.ejs"
        }
      }
    },
    "ejs-output-escaped": {
      "name": "meta.embedded.output.escaped.ejs",
      "begin": "(<%)(=)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.output.ejs"
        },
        "2": {
          "name": "keyword.operator.output.escaped.ejs"
        }
      },
      "end": "(?:(-)|(_))?(%>)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.whitespace.trim.ejs"
        },
        "2": {
          "name": "keyword.operator.whitespace.slurp.ejs"
        },
        "3": {
          "name": "punctuation.section.embedded.end.output.escaped.ejs"
        }
      },
      "contentName": "source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "ejs-output-unescaped": {
      "name": "meta.embedded.output.unescaped.ejs",
      "begin": "(<%)(-)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.output.ejs"
        },
        "2": {
          "name": "keyword.operator.output.unescaped.ejs"
        }
      },
      "end": "(?:(-)|(_))?(%>)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.whitespace.trim.ejs"
        },
        "2": {
          "name": "keyword.operator.whitespace.slurp.ejs"
        },
        "3": {
          "name": "punctuation.section.embedded.end.output.unescaped.ejs"
        }
      },
      "contentName": "source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "ejs-scriptlet-slurp": {
      "name": "meta.embedded.scriptlet.slurp.ejs",
      "begin": "(<%)(_)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.scriptlet.ejs"
        },
        "2": {
          "name": "keyword.operator.whitespace.slurp.ejs"
        }
      },
      "end": "(?:(-)|(_))?(%>)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.whitespace.trim.ejs"
        },
        "2": {
          "name": "keyword.operator.whitespace.slurp.ejs"
        },
        "3": {
          "name": "punctuation.section.embedded.end.scriptlet.ejs"
        }
      },
      "contentName": "source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "ejs-scriptlet-control": {
      "name": "meta.embedded.scriptlet.control.ejs",
      "begin": "<%(?![#=_\\-%])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.scriptlet.ejs"
        }
      },
      "end": "(?:(-)|(_))?(%>)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.whitespace.trim.ejs"
        },
        "2": {
          "name": "keyword.operator.whitespace.slurp.ejs"
        },
        "3": {
          "name": "punctuation.section.embedded.end.scriptlet.ejs"
        }
      },
      "contentName": "source.js",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    }
  }
}
